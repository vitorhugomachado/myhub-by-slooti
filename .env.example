# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Cookie/session signing — required in production (min 32 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# Optional: keep stable if you rotate SESSION_SECRET (legacy SHA256 password hashes)
# PASSWORD_PEPPER="same-as-old-session-secret-if-rotating"

# Google OAuth (login + Meet)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
